<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullable, implicit usings, and warnings-as-errors are repo-wide
       policy — see ..\Directory.Build.props. Only per-project decisions live here. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Opt out of the repo-wide GenerateDocumentationFile: a test assembly ships
         no public API, so a doc file would only invite CS1591 noise on xUnit
         fixtures. Warnings-as-errors still applies (inherited from props). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference: this project compiles against AngleSharp.Dom types
         (rationale in Directory.Packages.props). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XgFilter_Razor\XgFilter_Razor.csproj" />
    <!-- The producer's own test-support assembly, exercised here the way a host
         suite exercises it — the seam ships to hosts, so it is pinned against a
         real panel render rather than trusted. -->
    <ProjectReference Include="..\XgFilter_Razor.Testing\XgFilter_Razor.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
