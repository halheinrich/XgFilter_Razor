<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullable, implicit usings, warnings-as-errors, and doc-file
       generation are repo-wide policy — see ..\Directory.Build.props. This
       assembly keeps the doc-file default rather than opting out as the test
       project does: it ships a public surface that host suites compile
       against, so its members carry XML docs from birth like any other.
       Only per-project decisions live here. -->
  <PropertyGroup>
    <!-- Test support, never product. This assembly exists so host test suites
         can state the filter surface's storage in its own terms ("a previous
         visit committed this selection", "the panel mounts") without
         repeating a producer key or an interop call; it is not packed and
         never ships beside the component library. Nothing in the app graph
         may reference it — only test projects. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- bUnit is a first-class dependency here, not an accident of the test
         stack: the plans this assembly declares are answered on a bUnit
         JSInterop, through BgUiPrimitives_Razor.TestSupport's planner below. -->
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XgFilter_Razor\XgFilter_Razor.csproj" />
    <!-- Direct reference: this project compiles against FilterConfig, so the
         dependency is declared rather than taken transitively through the
         component library — same rule the test project follows for AngleSharp
         (rationale in Directory.Packages.props). -->
    <ProjectReference Include="..\..\XgFilter_Lib\XgFilter_Lib\XgFilter_Lib.csproj" />
    <!-- The storage planner (halheinrich/backgammon#377): this assembly states
         the surface's calls as BrowserStoragePlan expectations, so neither it
         nor a host spells an interop identifier. Its bunit and AngleSharp
         versions are the floor for this repo's (both repositories pin the
         same ones in their Directory.Packages.props). -->
    <ProjectReference Include="..\..\BgUiPrimitives_Razor\BgUiPrimitives_Razor.TestSupport\BgUiPrimitives_Razor.TestSupport.csproj" />
  </ItemGroup>

</Project>
