<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Framework, nullable, implicit usings, warnings-as-errors, and doc-file
       generation are repo-wide policy — see ..\Directory.Build.props. Only
       per-project decisions live here: the Razor SDK (project attribute above)
       and the browser SupportedPlatform. -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- This library's half of the trim gate (halheinrich/backgammon#129, taken
       up here in halheinrich/backgammon#193): the assembly declares itself
       trim-compatible and runs the trim analyzer in its own build, so a
       reflection-serialization regression becomes a build error *here*
       (TreatWarningsAsErrors) rather than a publish-time failure in BgQuiz,
       which is where that arc's first leg was caught. Per-project deliberately —
       the test project is not a shipped surface. IsTrimmable is pinned by
       XgFilterRazorTrimPostureTests. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only. FilterPanel's localStorage keys are internal so FilterHelp can
         render them in user copy from the one constant; the wiring test that pins
         that copy to the constant needs the same access. Grants nothing to
         consumers — the keys stay invisible outside this repo by design. -->
    <InternalsVisibleTo Include="XgFilter_Razor.Tests" />
    <!-- Producer-owned test support (XgFilter_Razor.Testing). It seeds the
         stored selection for host suites from the same ConfigKey constant, so
         the key stays invisible outside this repo while hosts stop repeating
         it as a literal. Also producer-side: the grant does not widen what
         consumers can see. -->
    <InternalsVisibleTo Include="XgFilter_Razor.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
    <ProjectReference Include="..\..\XgFilter_Lib\XgFilter_Lib\XgFilter_Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
