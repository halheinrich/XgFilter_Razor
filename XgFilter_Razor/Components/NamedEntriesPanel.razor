@using BgDataTypes_Lib
@typeparam TValue where TValue : IJsonDocument<TValue>
@typeparam TSelf where TSelf : NamedCollection<TValue, TSelf>, INamedCollectionSpecialization<TValue, TSelf>

@* ── NamedEntriesPanel.razor ─────────────────────────────────────────────────
   Consumer surface, unlike FilterPanel: this is the reusable piece the
   named-document arc exists for (halheinrich/backgammon#190 leg (D)) — a host
   with its own NamedCollection document mounts it directly, supplying a
   NamedEntriesSurface for the copy and ids the generic cannot know.
   Persistence-agnostic pick list over any NamedCollection. The panel owns
   no document state and mutates nothing: every gesture is raised as a request
   (OnLoadRequested / OnSaveRequested / OnSaveAsRequested / OnDeleteRequested)
   for the host to mediate — the host calls With/Without, persists wherever it
   persists, and passes the new collection instance back down through Document.
   Selection is deliberately stateless: the "current" value lives in whatever
   editor the host wires up and would go stale the moment the user edits
   there, so a highlighted row would be a second source of truth that lies.
   Every destructive gesture runs through an inline confirm here — a row's
   Save (overwrite this entry with the current value), a save-as under an
   existing name, and delete (the lib's With doc assigns overwrite
   confirmation to "the consumer's UI concern"; keeping it in the shared panel
   gives every mount identical UX, and Contains keeps the case-insensitive name
   rule in the lib). Both save gestures snapshot the same thing — whatever the
   host's editor hands over — a row Save differs from save-as only in taking
   its name from the row.
   Hosts that cannot persist right now (e.g. a missing FS-Access grant) say so
   via CanPersist — the panel is told, it never knows.
   The one thing the panel says in its own voice is the load confirmation.
   Load is the single gesture whose outcome the panel can observe without
   guessing — the request returned and nothing threw — and it produces no
   document swap, so nothing else would ever tell the user it landed;
   "{name} loaded." is therefore panel-local, and every mount gets it with no
   wiring. Host rulings stay the host's to explain (a refused save, a failed
   write): those are judgements the panel does not make and must not narrate.
   Location: XgFilter_Razor/Components/NamedEntriesPanel.razor
──────────────────────────────────────────────────────────────────────────── *@

<div class="card mb-4" style="max-width:800px">
    <div class="card-header">
        <strong>@Surface.Title</strong>
    </div>
    <div class="card-body">

        @* ── Pick list ───────────────────────────────────────────────────────
           Names verbatim from the collection — the lib owns the sort. *@
        @if (Document.Count == 0)
        {
            <p class="text-muted mb-3">@Surface.EmptyText</p>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var name in Document.Names)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@name</span>
                        @if (_pendingDeleteName == name)
                        {
                            <div class="d-flex gap-2 align-items-center">
                                <span>Delete '@name'?</span>
                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => ConfirmDeleteAsync(name)">
                                    Confirm delete
                                </button>
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => _pendingDeleteName = null">
                                    Cancel
                                </button>
                            </div>
                        }
                        else if (_pendingSaveName == name)
                        {
                            @* Copy deliberately distinguishable from the save-as
                               overwrite prompt ("Overwrite 'name'?"): a row Save
                               replaces an entry picked by row, so the prompt says
                               what replaces it — the surface's noun. *@
                            <div class="d-flex gap-2 align-items-center">
                                <span>Overwrite '@name' with @Surface.OverwriteWithNoun?</span>
                                <button class="btn btn-primary btn-sm"
                                        @onclick="() => ConfirmSaveAsync(name)">
                                    Overwrite
                                </button>
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => _pendingSaveName = null">
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="() => LoadClickedAsync(name)">
                                    Load
                                </button>
                                <button class="btn btn-outline-primary btn-sm"
                                        disabled="@(!CanPersist)"
                                        title="@DisabledTitle"
                                        @onclick="() => RequestSave(name)">
                                    Save
                                </button>
                                <button class="btn btn-outline-danger btn-sm"
                                        disabled="@(!CanPersist)"
                                        title="@DisabledTitle"
                                        @onclick="() => RequestDelete(name)">
                                    Delete
                                </button>
                            </div>
                        }
                    </li>
                }
            </ul>
        }

        @* ── Save-as row ───────────────────────────────────────────────────── *@
        @if (_pendingOverwriteName is null)
        {
            <div class="d-flex gap-2">
                <input id="@Surface.NameInputId" class="form-control" style="max-width:300px"
                       placeholder="@Surface.NamePlaceholder"
                       value="@_saveNameText"
                       @oninput="e => _saveNameText = e.Value?.ToString() ?? string.Empty" />
                <button id="@Surface.SaveButtonId" class="btn btn-primary btn-sm"
                        disabled="@(!CanPersist || IsSaveNameBlank)"
                        title="@DisabledTitle"
                        @onclick="SaveClickedAsync">
                    Save
                </button>
            </div>
        }
        else
        {
            <div class="d-flex gap-2 align-items-center">
                <span>Overwrite '@_pendingOverwriteName'?</span>
                <button class="btn btn-primary btn-sm" @onclick="ConfirmOverwriteAsync">
                    Overwrite
                </button>
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="() => _pendingOverwriteName = null">
                    Cancel
                </button>
            </div>
        }

        @if (!CanPersist && PersistDisabledReason is not null)
        {
            <div class="form-text">@PersistDisabledReason</div>
        }

        @* ── Load confirmation ───────────────────────────────────────────────
           Loading rewrites whatever the host's editor shows without touching
           anything in this card, so without this line the gesture is silent
           (halheinrich/backgammon#171). A completed action the user asked
           for: polite, not assertive — role="status", the same idiom the
           composite's outcome notices use, and an implicitly polite live
           region.
           The region itself is rendered unconditionally and only its content
           swaps: a live region that first appears in the very render that
           fills it is announced unreliably across screen readers, and this
           one fills and empties repeatedly through a session.

           So the region announces and the box inside it must not: it renders
           through the shared Notice as ByEnclosingRegion, which puts no role
           and no live-region attribute on any element of the box. A
           self-announcing notice here would be one live region nested in
           another — announced twice by some screen readers.

           An event notice, so dismissible (the umbrella's SPEC-notices.md).
           The occurrence is one accepted load, and this panel owns it outright:
           _loadedName is non-null exactly while a confirmation stands. So
           closing the box ends the occurrence — the field is cleared, as every
           other retiring gesture already clears it — and there is no dismissed
           bit anywhere, here or in the Notice (the binding makes it
           caller-held, so it keeps none). Loading the same name again assigns
           the field again and shows fresh: the name was never the occurrence.
           No @if around it — one fact, read once; the component renders
           nothing while no confirmation stands. *@
        <div id="@Surface.LoadedNoticeId" role="status">
            <Notice class="mt-3 mb-0"
                    Kind="NoticeKind.Success" Announcement="NoticeAnnouncement.ByEnclosingRegion"
                    Dismissible="true"
                    @bind-Dismissed:get="_loadedName is null"
                    @bind-Dismissed:set="_ => _loadedName = null">
                @_loadedName loaded.
            </Notice>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The document to render. Immutable — after mediating a save or delete
    /// the host passes the <em>new</em> instance returned by
    /// <see cref="NamedCollection{TValue, TSelf}.With"/> /
    /// <see cref="NamedCollection{TValue, TSelf}.Without"/> back down, and the
    /// panel re-renders from its
    /// <see cref="NamedCollection{TValue, TSelf}.Names"/>. A reference change
    /// also cancels any pending inline confirm (it was posed against the old
    /// document). Required: the panel is meaningless without a document, so
    /// <see cref="EditorRequiredAttribute"/> makes a missing binding an
    /// <c>RZ2012</c> compile error rather than a silent Razor splat. Both type
    /// arguments are inferred from what is bound here.
    /// </summary>
    [Parameter, EditorRequired]
    public NamedCollection<TValue, TSelf> Document { get; set; } = NamedCollection<TValue, TSelf>.Empty;

    /// <summary>
    /// The copy and element ids this mount renders — everything about a
    /// particular document that the generic cannot know; see
    /// <see cref="NamedEntriesSurface"/>. Required: there is no neutral
    /// default for a card title or an element id, and a panel that invented
    /// one would render a pick list no host's tests could find.
    /// </summary>
    [Parameter, EditorRequired]
    public NamedEntriesSurface Surface { get; set; } = default!;

    /// <summary>
    /// Raised when the user clicks a row's Load button, carrying the entry
    /// name. The host resolves it (e.g.
    /// <see cref="NamedCollection{TValue, TSelf}.TryGet"/>) and pushes the
    /// value wherever it goes. The panel mutates nothing. Required: the button
    /// renders unconditionally, and an unbound callback would be a silent
    /// no-op affordance.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnLoadRequested { get; set; }

    /// <summary>
    /// Raised only after the user confirms a row's inline Save prompt,
    /// carrying that row's name — "overwrite this entry with the current
    /// value". Like save-as, the host snapshots its editor's live state —
    /// unapplied edits included — calls
    /// <see cref="NamedCollection{TValue, TSelf}.With"/>, persists, and passes
    /// the new collection back down; the two gestures differ only in where the
    /// name comes from. The panel mutates nothing. Required for the same
    /// silent-splat reason as <see cref="OnLoadRequested"/>.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnSaveRequested { get; set; }

    /// <summary>
    /// Raised when the user commits save-as — including only <em>after</em>
    /// the inline confirm when the name already exists (case-insensitively,
    /// per <see cref="NamedCollection{TValue, TSelf}.Contains"/>) — carrying
    /// the trimmed, non-blank name, pre-normalized to satisfy
    /// <see cref="NamedCollection{TValue, TSelf}.With"/>'s name contract. The
    /// host snapshots the value, calls <c>With</c>, persists, and passes the
    /// new collection back down. Required for the same silent-splat reason as
    /// <see cref="OnLoadRequested"/>.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnSaveAsRequested { get; set; }

    /// <summary>
    /// Raised only after the user confirms a row's inline delete prompt,
    /// carrying the name. The host calls
    /// <see cref="NamedCollection{TValue, TSelf}.Without"/>, persists, and
    /// passes the new collection back down. Required for the same
    /// silent-splat reason as <see cref="OnLoadRequested"/>.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnDeleteRequested { get; set; }

    /// <summary>
    /// Gates the mutating affordances — Save and Delete — as one switch: both
    /// mutate the persisted document, so a host that cannot persist right now
    /// (e.g. BgQuiz without its FS-Access grant) disables both by binding this.
    /// Load stays enabled regardless; it is read-only over a collection already
    /// in memory. Defaults to <see langword="true"/>. The handlers early-return
    /// as well, so the contract holds even for programmatic event dispatch that
    /// ignores the <c>disabled</c> attribute.
    /// </summary>
    [Parameter]
    public bool CanPersist { get; set; } = true;

    /// <summary>
    /// Optional host-supplied explanation shown while
    /// <see cref="CanPersist"/> is <see langword="false"/> — as the disabled
    /// buttons' <c>title</c> and as a muted hint line — e.g. "Grant folder
    /// access to save filters." Ignored while persisting is enabled.
    /// </summary>
    [Parameter]
    public string? PersistDisabledReason { get; set; }

    // Save-as name buffer. Trimmed at the moment of raising — the With
    // contract says the caller normalizes; the panel is that caller's proxy.
    private string _saveNameText = string.Empty;

    // At most one row confirm (Save or Delete) is pending at a time — they
    // occupy the same slot in a row, so starting either gesture replaces any
    // pending row confirm of either kind — and at most one save-as overwrite
    // confirm besides. All are view-state posed against the current Document
    // instance and are cleared when that instance changes.
    private string? _pendingDeleteName;
    private string? _pendingSaveName;
    private string? _pendingOverwriteName;

    // Tracks the previous Document reference across parameter sets so a
    // document swap (the host acted, or reloaded) cancels stale confirms.
    private NamedCollection<TValue, TSelf>? _lastSeenDocument;

    // The name from the last Load the host accepted, or null when no
    // confirmation stands. View-state about this panel's own gesture — the
    // same category as the pending confirms above, and retired by the same
    // rule: it says where the panel's values just came from, so the moment
    // any other gesture actually begins (past its guards) it no longer
    // describes the panel and is cleared there; a new Document instance
    // clears it too, through the OnParametersSet reset, and so does the user
    // closing the confirmation — this field is that notice's whole state, so
    // there is no dismissed bit beside it (see the markup). Cancelling a confirm
    // needs no clear of its own — the gesture that posed the confirm already
    // did it. Never inferred from the arriving document: that would be the
    // causation guessing OnParametersSet refuses.
    private string? _loadedName;

    private bool IsSaveNameBlank => _saveNameText.Trim().Length == 0;

    private string? DisabledTitle => CanPersist ? null : PersistDisabledReason;

    protected override void OnParametersSet()
    {
        // A new Document instance is the host's confirmation channel: any new
        // document resets all in-flight view-state posed against the old one —
        // the pending confirms and the typed save-as name alike. Causation is
        // deliberately not tracked: the panel does not know (and must not
        // guess) whether the swap was its own save landing, a delete, or a
        // host re-pick, so a successful save clears the input via the same
        // reset that a delete or reload does. Inferring "my save confirmed"
        // (an awaiting-confirmation flag, or a Contains check on the arriving
        // document) would be the second source of truth this panel's
        // statelessness exists to avoid — and it lies subtly, e.g. a re-pick
        // to a document that happens to contain the just-typed name.
        if (!ReferenceEquals(_lastSeenDocument, Document))
        {
            _lastSeenDocument = Document;
            _pendingDeleteName = null;
            _pendingSaveName = null;
            _pendingOverwriteName = null;
            _saveNameText = string.Empty;
            _loadedName = null;
        }
    }

    // Clear-then-raise-then-state: the previous confirmation goes first, so a
    // host handler that throws leaves none standing rather than the stale one,
    // and the new one is stated only once the request has come back without
    // throwing — the panel applies nothing itself, so the host's return is the
    // whole of what it can honestly claim. The exception still propagates
    // untouched; swallowing it to keep the notice quiet would hide a real
    // failure. Load is ungated by CanPersist, like the button that calls it.
    private async Task LoadClickedAsync(string name)
    {
        _loadedName = null;
        await OnLoadRequested.InvokeAsync(name);
        _loadedName = name;
    }

    private void RequestDelete(string name)
    {
        if (!CanPersist) return;
        _loadedName = null;
        _pendingDeleteName = name;
        _pendingSaveName = null;
    }

    private async Task ConfirmDeleteAsync(string name)
    {
        if (!CanPersist) return;
        _loadedName = null;
        _pendingDeleteName = null;
        await OnDeleteRequested.InvokeAsync(name);
    }

    private void RequestSave(string name)
    {
        if (!CanPersist) return;
        _loadedName = null;
        _pendingSaveName = name;
        _pendingDeleteName = null;
    }

    // Clear-then-raise, the delete idiom — unlike save-as there is no typed
    // name to preserve for a retry, so the prompt does not ride the
    // confirmation swap. A save the host refuses (invalid value) surfaces
    // through the host's own notice.
    private async Task ConfirmSaveAsync(string name)
    {
        if (!CanPersist) return;
        _loadedName = null;
        _pendingSaveName = null;
        await OnSaveRequested.InvokeAsync(name);
    }

    private Task SaveClickedAsync()
    {
        if (!CanPersist) return Task.CompletedTask;
        var name = _saveNameText.Trim();
        if (name.Length == 0) return Task.CompletedTask;

        // Past the guards: a save gesture is genuinely under way, so the load
        // confirmation is retired whether this poses the overwrite prompt or
        // raises outright. Refusals above leave it standing — nothing happened.
        _loadedName = null;

        // Contains keeps the case-insensitive one-name rule in the lib — the
        // panel never re-implements the comparison.
        if (Document.Contains(name))
        {
            _pendingOverwriteName = name;
            return Task.CompletedTask;
        }

        return RaiseSaveAsync(name);
    }

    private async Task ConfirmOverwriteAsync()
    {
        if (!CanPersist || _pendingOverwriteName is null) return;
        _loadedName = null;
        await RaiseSaveAsync(_pendingOverwriteName);
    }

    private async Task RaiseSaveAsync(string name)
    {
        // Raise only — no optimistic clear. The typed name and the overwrite
        // prompt are cleared when (and only when) the host's new collection
        // instance arrives through Document, in OnParametersSet. A save the
        // host refuses (invalid value) or that fails to persist raises no swap,
        // so the name survives for the user to fix and retry. The overwrite
        // prompt's own dismissal likewise rides that swap; Cancel clears it
        // directly (see the save-as row markup).
        await OnSaveAsRequested.InvokeAsync(name);
    }
}
