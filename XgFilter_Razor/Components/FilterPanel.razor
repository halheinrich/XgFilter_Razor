@namespace XgFilter_Razor.Components.Internal
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@using System.Diagnostics.CodeAnalysis
@using XgFilter_Lib.Filtering
@using XgFilter_Lib.Enums
@using XgFilter_Lib.Patterns
@using BgDataTypes_Lib
@inject IJSRuntime JS

@* ── FilterPanel.razor ───────────────────────────────────────────────────────
   NOT consumer surface. Hosts embed FilterSurface, which owns this panel and
   the interaction wiring; the .Internal namespace + EditorBrowsable(Never)
   are the strongest narrowing the Razor toolchain allows (a true `internal`
   component draws CS0262 — the generator hardcodes `public partial`; spike
   result recorded in INSTRUCTIONS Pitfalls). Consuming it from a host is
   banned outright — including host tests (no FindComponent<FilterPanel>).
   Owns all filter state. Raises OnFilterConfigChanged only when "Apply Filter"
   is clicked (or "Clear filters"). Raises OnAppliedStateChanged after every
   buffer-affecting gesture, carrying the committed config the buffers now
   equal (null when they equal none), so the parent can gate downstream actions
   on whether the panel's selection is still the one it acted on. That same
   truth gates Apply itself: re-applying an unchanged selection is not offered.
   Consumers that need a DecisionFilterSet call FilterConfig.Build() on the
   received config.
   Information hierarchy: the error-range section is first and always visible;
   the other eight sections sit behind one disclosure, default hidden. While
   collapsed, the toggle carries a signal naming any hidden sections that hold
   active filters — see the disclosure-toggle comment for how it is computed.
   State persists to localStorage under two keys: the whole filter selection as
   one serialized FilterConfig blob (lib-owned shape via FilterConfig.ToJson /
   TryFromJson), and the disclosure's expand/collapse choice under its own key
   (DisclosureKey) — user preference, never part of the config blob.
   Location: XgFilter_Razor/Components/FilterPanel.razor
──────────────────────────────────────────────────────────────────────────── *@

<div class="card mb-4" style="max-width:800px">
    <div class="card-header">
        <strong>Filters</strong>
    </div>
    <div class="card-body">

        @* ── Error range ──────────────────────────────────────────────────────
           First and always visible: dogfooding showed it is the panel's
           most-used control, so it never rides behind the disclosure. *@
        <div class="mb-3">
            <label class="form-label">
                Error range
                <small class="text-muted">(inclusive; blank = no bound)</small>
            </label>
            <div class="d-flex gap-2 align-items-center">
                <input class="form-control" style="max-width:140px"
                       type="number" step="0.001" placeholder="Min"
                       value="@_errorMinText"
                       @oninput="e => { _errorMinText = e.Value?.ToString() ?? string.Empty; ReportAppliedState(); }" />
                <span>–</span>
                <input class="form-control" style="max-width:140px"
                       type="number" step="0.001" placeholder="Max"
                       value="@_errorMaxText"
                       @oninput="e => { _errorMaxText = e.Value?.ToString() ?? string.Empty; ReportAppliedState(); }" />
            </div>
        </div>

        @* ── Disclosure toggle ────────────────────────────────────────────────
           An honest disclosure: a real button carrying aria-expanded /
           aria-controls over the always-rendered #moreFilters region, whose
           children render only while expanded. While collapsed, the toggle
           carries the hidden-active signal — a count badge plus the section
           names — computed from the live edit buffers through the same build
           path Apply uses (BuildConfig) and the lib's GetActiveFacets(), minus
           ErrorRange, which is always visible above. The facet labels are the
           section headings by the lib's design (FilterFacet [Description]s),
           so the signal names exactly the sections the user will find on
           expanding. Never computed by re-inspecting config fields or edit
           buffers — the activation predicates are the lib's SSOT. Because the
           source is the live buffers, the signal is honest at rest (after
           restore, Apply, Clear, and LoadConfig staging) and live mid-edit.
           The expand/collapse choice belongs to the user, not the config: it
           persists under DisclosureKey, and LoadConfig / Clear filters never
           move it. *@
        @{ var hiddenActive = HiddenActiveFacets; }
        <div class="mb-3 d-flex gap-2 align-items-center">
            <button type="button" id="moreFiltersToggle"
                    class="btn btn-outline-secondary btn-sm"
                    aria-expanded="@(_moreFiltersExpanded ? "true" : "false")"
                    aria-controls="moreFilters"
                    @onclick="ToggleMoreFiltersAsync">
                @(_moreFiltersExpanded ? "Hide more filters" : "Show more filters")
                @if (!_moreFiltersExpanded && hiddenActive.Count > 0)
                {
                    <span id="hiddenActiveCount" class="badge text-bg-primary ms-1">@hiddenActive.Count</span>
                }
            </button>
            @if (!_moreFiltersExpanded && hiddenActive.Count > 0)
            {
                <small id="hiddenActiveNames" class="text-muted">
                    Active: @string.Join(", ", hiddenActive.Select(f => f.ToLabel()))
                </small>
            }
        </div>

        <div id="moreFilters">
            @if (_moreFiltersExpanded)
            {
                @* ── Player ──────────────────────────────────────────────────── *@
                <div class="mb-3">
                    <label class="form-label">
                        Player names
                        <small class="text-muted">(comma-separated; blank = all players)</small>
                    </label>
                    <input class="form-control"
                           placeholder="e.g. Hal, Magriel"
                           value="@_playerText"
                           @oninput="e => { _playerText = e.Value?.ToString() ?? string.Empty; ReportAppliedState(); }" />
                </div>

                @* ── Decision type ───────────────────────────────────────────── *@
                <div class="mb-3">
                    <label class="form-label">Decision type</label>
                    <div>
                        @foreach (var opt in Enum.GetValues<DecisionTypeOption>())
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio"
                                       name="decisionType"
                                       id="dt_@opt"
                                       checked="@(_decisionType == opt)"
                                       @onchange="() => { _decisionType = opt; ReportAppliedState(); }" />
                                <label class="form-check-label" for="dt_@opt">
                                    @opt.ToLabel()
                                </label>
                            </div>
                        }
                    </div>
                </div>

                @* ── Match score ─────────────────────────────────────────────── *@
                <div class="mb-3">
                    <label class="form-label">
                        Match scores
                        <small class="text-muted">(comma-separated; blank = all scores)</small>
                    </label>
                    <input class="form-control"
                           placeholder="e.g. 4a5a, 1a1a, 1a2aC, money"
                           value="@_matchScoreText"
                           @oninput="e => { _matchScoreText = e.Value?.ToString() ?? string.Empty; ReportAppliedState(); }" />
                    <div class="form-text">
                        MaNa is on-roll-anchored — M = points the player on roll needs, N = the
                        opponent — so 4a5a and 5a4a are distinct (list both to catch either
                        orientation). C suffix = Crawford game; money = money sessions; DMP = 1a1a.
                    </div>
                </div>

                @* ── Move number range ───────────────────────────────────────── *@
                <div class="mb-3">
                    <label class="form-label">
                        Move number range
                        <small class="text-muted">(inclusive; blank = no bound; non-standard-start games are excluded)</small>
                    </label>
                    <div class="d-flex gap-2 align-items-center">
                        <input class="form-control" style="max-width:140px"
                               type="number" step="1" min="1" placeholder="Min"
                               value="@_moveNumberMinText"
                               @oninput="e => { _moveNumberMinText = e.Value?.ToString() ?? string.Empty; ReportAppliedState(); }" />
                        <span>–</span>
                        <input class="form-control" style="max-width:140px"
                               type="number" step="1" min="1" placeholder="Max"
                               value="@_moveNumberMaxText"
                               @oninput="e => { _moveNumberMaxText = e.Value?.ToString() ?? string.Empty; ReportAppliedState(); }" />
                    </div>
                </div>

                @* ── Contact type ────────────────────────────────────────────── *@
                <div class="mb-3">
                    <label class="form-label">
                        Contact type
                        <small class="text-muted">(none checked = all types)</small>
                    </label>
                    <div>
                        @foreach (var ct in Enum.GetValues<ContactType>())
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox"
                                       id="ct_@ct"
                                       checked="@_contactTypes.Contains(ct)"
                                       @onchange="(e) => { if (e.Value is bool b && b) _contactTypes.Add(ct); else _contactTypes.Remove(ct); ReportAppliedState(); }" />
                                <label class="form-check-label" for="ct_@ct">@ct.ToLabel()</label>
                            </div>
                        }
                    </div>
                </div>

                @* ── Analysis depth ──────────────────────────────────────────── *@
                @* Union-of-clauses facet over BgDataTypes_Lib's AnalysisMode ×
                   AnalysisLevel: three per-mode pairs, each a mode toggle plus its own
                   level group. The panel binds the six raw-intent inputs (three bools,
                   three level sets) verbatim and derives nothing — the mapping to
                   AnalysisDepthFilter clauses (one clause per enabled toggle, empty
                   level list = any level, all toggles off = facet off, inert level
                   lists) lives only in FilterConfig.Build(); re-encoding it here would
                   duplicate the SSOT and silently drift — see this panel's Pitfalls and
                   XgFilter_Lib's Depth-facet block. Mode labels come from AnalysisMode's
                   [Description]s via EnumLabel.ToLabel, never hardcoded. Levels render
                   in Enum.GetValues declaration order (the lib's ascending-rigor order);
                   Unknown is a first-class, selectable level.

                   Each level group is an honest disclosure in the #moreFilters idiom —
                   real button, aria-expanded / aria-controls, children rendered only
                   while expanded — but deliberately UNPERSISTED, unlike the panel-level
                   disclosure's xg_moreFiltersExpanded key: while collapsed, the count
                   badge ("any" / "N selected", the hidden-active-signal ruling) already
                   carries everything the closed state hides, so remembering the open
                   state buys no information and would cost three more localStorage keys.
                   The badge reads the live buffer, so it is honest mid-edit and after
                   restore / LoadConfig / Clear. Collapsing or expanding a group is
                   navigation, not an edit — no ReportAppliedState.

                   Unchecking a mode hides its level group but keeps the checked levels
                   in the buffer (and in the emitted config): the lib guarantees a level
                   list whose toggle is off is inert — no activation, no constraint — so
                   re-toggling the mode restores the user's selection instead of
                   punishing an exploratory untoggle. *@
                <div class="mb-3">
                    <label class="form-label">
                        Analysis depth
                        <small class="text-muted">(check the modes you want to see — checking more shows more; nothing checked means no depth filter)</small>
                    </label>
                    @foreach (var group in DepthGroups)
                    {
                        <div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="md_@group.Mode"
                                       checked="@group.Include"
                                       @onchange="(e) => { group.Include = e.Value is bool b && b; ReportAppliedState(); }" />
                                <label class="form-check-label" for="md_@group.Mode">@group.Mode.ToLabel()</label>
                            </div>
                            @if (group.Include)
                            {
                                <div class="ms-4 mb-2">
                                    <button type="button" id="lvlToggle_@group.Mode"
                                            class="btn btn-link btn-sm p-0 text-decoration-none"
                                            aria-expanded="@(group.LevelsExpanded ? "true" : "false")"
                                            aria-controls="lvl_@group.Mode"
                                            @onclick="() => group.LevelsExpanded = !group.LevelsExpanded">
                                        Analysis level
                                        @if (!group.LevelsExpanded)
                                        {
                                            <span id="lvlBadge_@group.Mode"
                                                  class="badge ms-1 @(group.Levels.Count > 0 ? "text-bg-primary" : "text-bg-secondary")">
                                                @(group.Levels.Count > 0 ? $"{group.Levels.Count} selected" : "any")
                                            </span>
                                        }
                                    </button>
                                    <div id="lvl_@group.Mode">
                                        @if (group.LevelsExpanded)
                                        {
                                            <div>
                                                @foreach (var level in Enum.GetValues<AnalysisLevel>())
                                                {
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="checkbox"
                                                               id="lv_@(group.Mode)_@level"
                                                               checked="@group.Levels.Contains(level)"
                                                               @onchange="(e) => { if (e.Value is bool b && b) group.Levels.Add(level); else group.Levels.Remove(level); ReportAppliedState(); }" />
                                                        <label class="form-check-label" for="lv_@(group.Mode)_@level">@level.ToLabel()</label>
                                                    </div>
                                                }
                                            </div>
                                            <div class="form-text">None checked = any level. @group.LevelHint</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* ── Dice rolls ──────────────────────────────────────────────── *@
                @* One checkbox per distinct roll, enumerated from DiceRoll.All — the lib
                   owns both the 21-roll set and its ascending canonical order (11, 21, 22,
                   31, … 66, the six doubles included), so the panel imposes no local roll
                   list or sort rule. Labels are the roll's own canonical token
                   (DiceRoll.ToString → "31"), rendered verbatim: display text stays owned
                   by the type, exactly as the enum facets defer to ToLabel. (A hyphenated
                   "3-1" presentation was considered; "31" keeps the panel free of any
                   label-munging and matches the lib's token one-for-one.) Selections are
                   stored raw in _diceRolls and handed to FilterConfig.Build() verbatim —
                   the panel derives nothing. None checked = facet off (Build() skips the
                   filter); the roll set is canonical/unordered, so checking "31" admits
                   both dice orders, and cube rows (no roll) never pass an active filter. *@
                <div class="mb-3">
                    <label class="form-label">
                        Dice rolls
                        <small class="text-muted">(none checked = all rolls; cube decisions never match)</small>
                    </label>
                    <div>
                        @foreach (var roll in DiceRoll.All)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox"
                                       id="dr_@roll"
                                       checked="@_diceRolls.Contains(roll)"
                                       @onchange="(e) => { if (e.Value is bool b && b) _diceRolls.Add(roll); else _diceRolls.Remove(roll); ReportAppliedState(); }" />
                                <label class="form-check-label" for="dr_@roll">@roll</label>
                            </div>
                        }
                    </div>
                </div>

                @* ── Position pattern ────────────────────────────────────────── *@
                @* Per-location checker-range constraint, entered as the lib's raw bracket
                   list until the board-grid widget replaces this field in a later arc.
                   Parsed through BoardPattern.TryParse so half-typed input never throws
                   out of the panel; while the text is non-blank and unparseable the
                   field is marked invalid and Apply is disabled, so an invalid pattern
                   can never silently drop the filter the user meant to set.

                   The help text below documents the lib's location vocabulary — board
                   indices plus the named borne-off tokens — but does not re-implement it:
                   BoardPattern remains the single source of truth for what parses, and a
                   wrong-signed borne-off bound (say [off,,-2]) fails TryParse and lands
                   in the same invalid-field state as any other unparseable text. *@
                <div class="mb-3">
                    <label class="form-label" for="positionPattern">
                        Position pattern
                        <small class="text-muted">(checker ranges by location; blank = no pattern filter)</small>
                    </label>
                    <input id="positionPattern"
                           class="form-control @(IsPositionPatternValid ? string.Empty : "is-invalid")"
                           placeholder="e.g. [6,2,] [5,,-2] [opp-off,,-2]"
                           value="@_positionPatternText"
                           @oninput="e => { _positionPatternText = e.Value?.ToString() ?? string.Empty; ReportAppliedState(); }" />
                    <div class="form-text">
                        [location,min,max] per location; blank bound = unbounded; positive counts
                        belong to the player on roll, negative to the opponent.
                        Locations: points 1–24, bar 25 (player on roll) and bar 0 (opponent),
                        plus borne off — off for the player on roll (bounds 0 to 15) and
                        opp-off for the opponent (bounds -15 to 0).
                        E.g. [6,2,] [5,,-2] [25,1,] [opp-off,,-2] [off,10,].
                    </div>
                    <div class="invalid-feedback">
                        Not a valid bracket list — fix it to apply, or clear it for no pattern filter.
                    </div>
                </div>
            }
        </div>

        @* ── Buttons ──────────────────────────────────────────────────────────
           "Clear filters" is the full-clear gesture under an honest name: it
           clears filter values only (buffers to defaults, persist + raise the
           empty config) — it never touches host state or the disclosure.
           Apply is gated on CanApply: the position pattern must be committable
           AND the selection must differ from the last-committed config.
           ApplyDisabledReason explains the second case in the
           SavedFiltersPanel disabled-reason idiom (title + muted hint line);
           the first already explains itself in the pattern field's own
           invalid-feedback line. Hoisted into a local like the hidden-active
           signal above: both surfaces of the reason read the one evaluation. *@
        @{ var applyDisabledReason = ApplyDisabledReason; }
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm"
                    disabled="@(!CanApply)"
                    title="@applyDisabledReason"
                    @onclick="ApplyAsync">
                Apply Filter
            </button>
            <button id="clearFilters" class="btn btn-outline-secondary btn-sm" @onclick="ClearFiltersAsync">
                Clear filters
            </button>
        </div>
        @if (applyDisabledReason is not null)
        {
            <div id="applyDisabledReason" class="form-text">@applyDisabledReason</div>
        }

    </div>
</div>

@code {
    /// <summary>
    /// Raised on <b>Apply</b> and on <b>Clear filters</b> — never per keystroke —
    /// carrying the committed <see cref="FilterConfig"/>. The same instance is first
    /// persisted to <c>localStorage</c> (see <see cref="ConfigKey"/>) so the panel
    /// rehydrates it on the next first render. A consumer that wants a
    /// <c>DecisionFilterSet</c> for in-memory filtering calls <c>cfg.Build()</c> on
    /// the received config; a consumer that ships the selection to a server
    /// serializes <c>cfg</c> as JSON. Required: the panel exists to produce this,
    /// so <see cref="EditorRequiredAttribute"/> makes a missing binding an
    /// <c>RZ2012</c> compile error rather than a silent Razor splat.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<FilterConfig> OnFilterConfigChanged { get; set; }

    /// <summary>
    /// Raised after <em>every</em> gesture that touches the edit buffers — a
    /// control edit (typing, radio, checkbox), <see cref="LoadConfig"/> staging,
    /// Apply, and Clear filters — carrying the committed <see cref="FilterConfig"/>
    /// the buffers now equal, or <see langword="null"/> when they equal none. A
    /// consumer gating a downstream action (a Run / Start button) on "is the
    /// panel's selection still the one I acted on?" compares the payload against
    /// the config it last received from <see cref="OnFilterConfigChanged"/>; a
    /// <see langword="null"/> payload always means uncommitted edits are pending.
    /// <para>
    /// <b>Per-gesture, not transition-only — deliberately.</b> The panel
    /// re-reports the current answer on every gesture rather than firing only
    /// when the answer changes, and the reason is remounting. The committed
    /// config is component-instance state that dies with the panel, so a freshly
    /// mounted panel has committed nothing and reports <see langword="null"/> on
    /// the user's first edit — while a consumer whose own applied state survived
    /// the navigation is still holding a config from the previous mount, and so
    /// a stale "clean" belief that only this event can correct. A transition-only
    /// event is silent in exactly that state, because from the new panel's point
    /// of view nothing transitioned. Consumers therefore handle it statelessly
    /// and idempotently — assign from the payload, never diff it against a
    /// remembered previous one.
    /// </para>
    /// Required: gating downstream actions is what this panel's consumers use it
    /// for, and an unbound callback fails silently at runtime as a gate that
    /// never re-opens, so <see cref="EditorRequiredAttribute"/> turns a missing
    /// binding into an <c>RZ2012</c> compile error — see the silent-splat entry
    /// in this subproject's Pitfalls.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<FilterConfig?> OnAppliedStateChanged { get; set; }

    /// <summary>
    /// Single <c>localStorage</c> key holding the whole filter state as one serialized
    /// <see cref="FilterConfig"/> blob. The lib owns the JSON shape (<c>ToJson</c> /
    /// <c>TryFromJson</c>); this component never touches a JSON serializer directly.
    /// </summary>
    /// <remarks>
    /// <c>internal</c>, not private, so <see cref="FilterHelp"/> can render the key
    /// name in its "what the panel remembers" copy from this one constant rather than
    /// repeating it as a prose literal. Deliberately not <c>public</c>: a consumer must
    /// never see — let alone depend on — this panel's storage keys, which is precisely
    /// why the copy naming them is producer-owned and lives here.
    /// </remarks>
    internal const string ConfigKey = "xg_filter_config";

    /// <summary>
    /// The disclosure's expand/collapse choice, under its own key (camelCase after the
    /// <c>xg_</c> prefix, per the sibling convention: <c>xg_quizMix</c>,
    /// <c>xg_xgpPattern</c>). User preference, not filter state — it never rides in the
    /// <see cref="ConfigKey"/> blob, and <see cref="LoadConfig"/> / Clear filters never
    /// change it. Values are the literals <c>"true"</c> / <c>"false"</c>; restore treats
    /// exactly <c>"true"</c> as expanded and anything else (missing, corrupt) as the
    /// default-hidden posture.
    /// </summary>
    /// <remarks>
    /// <c>internal</c> for the same reason as <see cref="ConfigKey"/> — see its remarks.
    /// </remarks>
    internal const string DisclosureKey = "xg_moreFiltersExpanded";

    // Free-text / numeric buffers. These exist only because in-progress typing
    // needs a string distinct from the parsed value; they are transient
    // view-state — hydrated from the config on restore, flushed back into a
    // config on Apply, and never persisted on their own.
    private string _playerText = string.Empty;
    private string _matchScoreText = string.Empty;
    private string _errorMinText = string.Empty;
    private string _errorMaxText = string.Empty;
    private string _moveNumberMinText = string.Empty;
    private string _moveNumberMaxText = string.Empty;
    private string _positionPatternText = string.Empty;

    // Enum state needs no string buffer — the controls bind directly.
    private DecisionTypeOption _decisionType = DecisionTypeOption.Both;
    private HashSet<ContactType> _contactTypes = new();

    // Depth facet — raw user intent as three per-mode pairs, stored verbatim
    // and handed to FilterConfig.Build() which owns the clause-union
    // derivation. The panel never maps toggles and level lists to clauses
    // itself (that SSOT lives in the lib; see the Analysis-depth markup
    // comment). Each group also carries its level disclosure's session-only
    // open/closed state — navigation, never persisted (see the markup comment
    // for why, in contrast to DisclosureKey).
    private sealed class DepthModeGroup
    {
        public required AnalysisMode Mode { get; init; }

        // Mode-specific hint line rendered after the shared "None checked =
        // any level." sentence — panel-owned copy explaining what "level"
        // means for this mode.
        public required string LevelHint { get; init; }

        public bool Include { get; set; }
        public HashSet<AnalysisLevel> Levels { get; set; } = new();
        public bool LevelsExpanded { get; set; }
    }

    private readonly DepthModeGroup _evaluations = new()
    {
        Mode = AnalysisMode.Evaluation,
        LevelHint = "The level is the evaluation's own.",
    };

    private readonly DepthModeGroup _rollouts = new()
    {
        Mode = AnalysisMode.Rollout,
        LevelHint = "The level is the inner level the rollout's games were played at — "
            + "checker plays never carry XG Roller-family inner levels.",
    };

    private readonly DepthModeGroup _bookRollouts = new()
    {
        Mode = AnalysisMode.BookRollout,
        LevelHint = "The level is the inner level from the opening-book entry, "
            + "when the book recorded it.",
    };

    // Render order = AnalysisMode declaration order (Evaluation, Rollout,
    // BookRollout). A property rather than a field because field initializers
    // cannot reference the instance fields above.
    private IReadOnlyList<DepthModeGroup> DepthGroups => [_evaluations, _rollouts, _bookRollouts];

    // Dice facet — the raw set of admitted rolls, stored verbatim and handed to
    // FilterConfig.Build(); empty = facet off. The roll set and its order are the
    // lib's (DiceRoll.All), never re-derived here.
    private HashSet<DiceRoll> _diceRolls = new();

    // The config this panel last committed — the one it raised through
    // OnFilterConfigChanged from Apply or Clear filters — and the reference
    // point for "has the selection moved since?". Plain component-instance
    // state, deliberately dying on unmount: a host that remounts the panel
    // (BgQuiz on a new folder pick) starts with nothing committed, which is
    // what re-enables Apply for the new folder without any host-side reset
    // call. Never persisted and never a holder: the first-render localStorage
    // restore *stages* a selection, it does not commit one, so a fresh mount
    // has no committed config even when it restores a full selection.
    //
    // A remount over an *unchanged* source is the one case where dying is the
    // wrong answer — the selection really is still applied, so Apply would
    // re-arm with nothing to do. FilterSurface reconciles that at its first
    // render through SeedCommitted, from the applied holder it mediates and
    // never from localStorage (see SeedCommitted and the composite's
    // first-mount reconcile).
    private FilterConfig? _committedConfig;

    // True once LoadConfig has staged an externally supplied config. The
    // first-render localStorage restore checks it both before and after its
    // await, so a restore completing late can never clobber an external load.
    // Blazor's single-threaded sync context makes the segments between awaits
    // atomic — a plain bool is a sufficient guard, no locking.
    private bool _externalConfigLoaded;

    // Disclosure state: default hidden. _disclosureTouched is the visibility
    // counterpart of _externalConfigLoaded — true once the user has toggled
    // this session, checked before and after the restore's await so a restore
    // completing late can never clobber a fresh user choice.
    private bool _moreFiltersExpanded;
    private bool _disclosureTouched;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await RestoreDisclosureAsync();
        await RestoreConfigAsync();
    }

    // Deliberately not gated by _externalConfigLoaded: LoadConfig stages
    // filter values, but the disclosure's visibility belongs to the user, so
    // a host-driven load must not suppress restoring it.
    private async Task RestoreDisclosureAsync()
    {
        if (_disclosureTouched) return;

        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", DisclosureKey);

        // Re-check after the await: a toggle click that landed while the
        // interop was in flight is a fresh user choice and must win.
        if (_disclosureTouched) return;

        // Tolerant restore: exactly "true" expands; anything else keeps the
        // default-hidden posture.
        if (stored == "true")
        {
            _moreFiltersExpanded = true;
            StateHasChanged();
        }
    }

    private async Task RestoreConfigAsync()
    {
        if (_externalConfigLoaded) return;

        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ConfigKey);

        // Re-check after the await: a host's LoadConfig may have run while the
        // interop was in flight, and the external config must win.
        if (_externalConfigLoaded) return;

        // Tolerant restore: a missing key, the literal null token, or corrupt
        // JSON all yield a fresh default config — no try/catch here.
        FilterConfig.TryFromJson(stored, out var cfg);
        HydrateFrom(cfg);

        StateHasChanged();
    }

    /// <summary>
    /// Projects <paramref name="config"/> into the panel's edit buffers as a
    /// staging-only bulk edit — exactly as if the user had typed every value.
    /// No <em>Apply-side</em> effects occur: nothing is persisted to
    /// <c>localStorage</c> and <see cref="OnFilterConfigChanged"/> is not
    /// raised — the user (or host) still commits via Apply, and this method
    /// never moves the committed config.
    /// <see cref="OnAppliedStateChanged"/> <em>is</em> raised, like any other
    /// edit gesture, reporting what the staged buffers now equal: normally
    /// <see langword="null"/>, since a loaded config generally differs from
    /// what was committed — but the committed config itself when the load
    /// happens to stage exactly it, which is a genuinely clean state and is
    /// reported as one. Calling this also suppresses the first-render
    /// <c>localStorage</c> restore, so a config loaded during host startup
    /// cannot be clobbered when the restore's interop completes afterwards.
    /// The disclosure's visibility is deliberately untouched — a staged config
    /// can activate hidden sections, which the toggle's hidden-active signal
    /// reports, but expanding is the user's gesture, never this method's.
    /// Must be called on the renderer's synchronization context (any event
    /// handler or lifecycle method qualifies), typically via <c>&#64;ref</c>.
    /// </summary>
    /// <param name="config">The configuration to stage. Read, never stored.</param>
    /// <exception cref="ArgumentNullException">
    /// Thrown when <paramref name="config"/> is <see langword="null"/>.
    /// </exception>
    public void LoadConfig(FilterConfig config)
    {
        ArgumentNullException.ThrowIfNull(config);
        _externalConfigLoaded = true;
        HydrateFrom(config);
        ReportAppliedState();
        StateHasChanged();
    }

    /// <summary>
    /// Snapshots the current edit buffers — including unapplied edits — into a
    /// <see cref="FilterConfig"/>, for host-driven save-as while the panel is
    /// dirty. The gate is exactly Apply's, single-sourced through the same
    /// build path: this fails only when the position-pattern text is non-blank
    /// and unparseable, the one state in which Apply is disabled. It is
    /// deliberately no stricter than Apply — match-score tokens ride raw here
    /// as on the Apply path, validated downstream by
    /// <see cref="FilterConfig.Build"/> — so save-as can capture exactly what
    /// Apply could produce.
    /// </summary>
    /// <param name="config">
    /// The snapshot when this returns <see langword="true"/>; otherwise
    /// <see langword="null"/>.
    /// </param>
    /// <returns>
    /// <see langword="true"/> when the buffers are in a state Apply would
    /// accept; <see langword="false"/> otherwise.
    /// </returns>
    public bool TryGetEditedConfig([NotNullWhen(true)] out FilterConfig? config)
    {
        if (!IsPositionPatternValid)
        {
            config = null;
            return false;
        }

        config = BuildConfig();
        return true;
    }

    /// <summary>
    /// Drops the last-committed config so Apply re-arms on a still-mounted
    /// panel — the programmatic equivalent of the remount that "a new folder
    /// re-enables Apply" falls out of, for hosts that keep the panel mounted
    /// across a source change. The buffers, the persisted
    /// <c>localStorage</c> state, and the disclosure are all untouched: the
    /// user's selection stays on screen, it just no longer counts as
    /// committed, so <see cref="OnAppliedStateChanged"/> re-reports through
    /// the normal path (necessarily <see langword="null"/> — the buffers can
    /// equal no committed config once there is none).
    /// <c>internal</c> by design: the composite component is the only
    /// intended caller (tests reach it via <c>InternalsVisibleTo</c>) — a
    /// host never needs it, because a host either remounts the panel or hosts
    /// the composite, which owns the source-change rule.
    /// </summary>
    internal void ForgetCommitted()
    {
        _committedConfig = null;
        ReportAppliedState();
        StateHasChanged();
    }

    /// <summary>
    /// Adopts <paramref name="config"/> as the last-committed config — the
    /// exact mirror of <see cref="ForgetCommitted"/>, for a fresh mount
    /// resuming a commit an earlier mount made. The committed config dies on
    /// unmount while the caller's applied state outlives it, so without this
    /// a remount arms Apply over a selection that is already applied: nothing
    /// to do, and the disabled-because-nothing-changed explanation missing
    /// with it. The buffers, the persisted <c>localStorage</c> state, and the
    /// disclosure are all untouched — this moves the reference point, never
    /// the selection — and nothing is written: the committed config stays
    /// unpersisted by contract (see this panel's Pitfalls), derived at mount
    /// from what the caller already holds.
    /// <para>
    /// <b>Silent, unlike <see cref="ForgetCommitted"/> — deliberately.</b>
    /// Forgetting is news: a gate the consumer believes clean just went
    /// stale, and only <see cref="OnAppliedStateChanged"/> can say so. A seed
    /// is by definition no news — the caller seeds from applied state it is
    /// already holding, so a report would only tell it what it just said.
    /// The asymmetry is the contract, not an oversight.
    /// </para>
    /// <c>internal</c> for exactly <see cref="ForgetCommitted"/>'s reason: the
    /// composite component is the only intended caller (tests reach it via
    /// <c>InternalsVisibleTo</c>) — it is the party that mediates the applied
    /// holder and can therefore say what was committed; a host holds no such
    /// answer about <em>this</em> panel.
    /// </summary>
    /// <param name="config">The config to treat as last-committed.</param>
    /// <exception cref="ArgumentNullException">
    /// Thrown when <paramref name="config"/> is <see langword="null"/>.
    /// </exception>
    internal void SeedCommitted(FilterConfig config)
    {
        ArgumentNullException.ThrowIfNull(config);
        _committedConfig = config;
        StateHasChanged();
    }

    // The panel's cleanliness truth, computed in one place and consumed by the
    // two surfaces that need it — the Apply gate (CanApply) and the payload of
    // OnAppliedStateChanged — so the button and the event can never disagree.
    // Null means the buffers equal no committed config: either nothing has been
    // committed this mount, or the selection has moved since. Equality is
    // FilterConfig's own value equality, which is precisely why an edit undone
    // back to the committed values counts as clean again — a one-way dirty flag
    // would strand the user behind a disabled Apply in exactly that state.
    // Unparseable position-pattern text builds as "no pattern" (see
    // ParsePositionPattern), so it never reads as a *different* config; it never
    // opens the gate either, because CanApply also requires
    // IsPositionPatternValid.
    private FilterConfig? MatchedCommittedConfig =>
        _committedConfig is not null && _committedConfig.Equals(BuildConfig())
            ? _committedConfig
            : null;

    // Apply's gate: the selection must be committable (a parseable position
    // pattern) and must differ from what was last committed.
    private bool CanApply => IsPositionPatternValid && MatchedCommittedConfig is null;

    // Why Apply is disabled — the SavedFiltersPanel disabled-reason idiom
    // (button title plus a muted hint line), except that here the panel knows
    // its own reason instead of being told it by the host. Covers only the
    // nothing-to-apply case: the invalid-pattern case already explains itself in
    // the pattern field's invalid-feedback line, and re-stating it here would be
    // a second encoding of the same rule. Null while Apply is enabled, so no
    // stale explanation lingers.
    private string? ApplyDisabledReason =>
        IsPositionPatternValid && MatchedCommittedConfig is not null
            ? "No changes to apply — this filter is already applied."
            : null;

    // Report what the buffers now equal, after a gesture that touched them.
    // Fire-and-forget like the edit handlers that call it: the panel has nothing
    // to await on the consumer's reaction.
    private void ReportAppliedState() => OnAppliedStateChanged.InvokeAsync(MatchedCommittedConfig);

    // Guarded as well as visually disabled, matching SavedFiltersPanel's
    // handler-side gates: programmatic event dispatch ignores the disabled
    // attribute, and re-committing an unchanged selection would raise a
    // spurious OnFilterConfigChanged.
    private Task ApplyAsync() =>
        CanApply ? PersistAndRaiseAsync(BuildConfig()) : Task.CompletedTask;

    // "Clear filters" — the full-clear gesture: hydrate every edit buffer back
    // to defaults, then persist + raise the empty config (consumers treat it
    // as applied). Filter values only: the panel has no path to host state,
    // and the disclosure's visibility is the user's choice, not this
    // gesture's.
    private Task ClearFiltersAsync()
    {
        var cfg = new FilterConfig();
        HydrateFrom(cfg);              // clear every edit-field back to defaults
        return PersistAndRaiseAsync(cfg);
    }

    // The single commit point — Apply and Clear filters both land here, and it
    // is the only place _committedConfig moves.
    private async Task PersistAndRaiseAsync(FilterConfig cfg)
    {
        _committedConfig = cfg;
        await JS.InvokeVoidAsync("localStorage.setItem", ConfigKey, cfg.ToJson());
        await OnFilterConfigChanged.InvokeAsync(cfg);

        // Re-derived through MatchedCommittedConfig rather than handing cfg
        // straight on: one computation feeds both the gate and the payload, so
        // the event can never claim clean while the button says otherwise.
        await OnAppliedStateChanged.InvokeAsync(MatchedCommittedConfig);
    }

    // Flip + persist the disclosure. Not an edit gesture: no
    // OnAppliedStateChanged and no config write — the choice is remembered
    // immediately under its own key, independent of Apply.
    private async Task ToggleMoreFiltersAsync()
    {
        _disclosureTouched = true;
        _moreFiltersExpanded = !_moreFiltersExpanded;
        await JS.InvokeVoidAsync("localStorage.setItem", DisclosureKey,
            _moreFiltersExpanded ? "true" : "false");
    }

    // The hidden-active signal's data: which disclosure-hidden sections
    // currently hold active filters, in FilterFacet declaration order (which
    // is Build()'s add order and, near enough, the panel's section order).
    // Judged by the lib's activation predicates via GetActiveFacets() on the
    // live buffers — the same build path Apply uses — never by re-inspecting
    // config fields here. ErrorRange is excluded as the one always-visible
    // facet. Recomputed per render; the cost is a buffer flush plus predicate
    // sweep, accepted over caching.
    private IReadOnlyList<FilterFacet> HiddenActiveFacets =>
        BuildConfig().GetActiveFacets().Where(f => f != FilterFacet.ErrorRange).ToList();

    // Flush the current buffers / enum state into a single FilterConfig.
    private FilterConfig BuildConfig() => new()
    {
        Players = SplitTokens(_playerText),
        DecisionType = _decisionType,
        MatchScores = SplitTokens(_matchScoreText),
        ErrorMin = ParseDouble(_errorMinText),
        ErrorMax = ParseDouble(_errorMaxText),
        MoveNumberMin = ParseInt(_moveNumberMinText),
        MoveNumberMax = ParseInt(_moveNumberMaxText),
        ContactTypes = _contactTypes.ToList(),
        IncludeEvaluations = _evaluations.Include,
        EvaluationLevels = _evaluations.Levels.ToList(),
        IncludeRollouts = _rollouts.Include,
        RolloutLevels = _rollouts.Levels.ToList(),
        IncludeBookRollouts = _bookRollouts.Include,
        BookRolloutLevels = _bookRollouts.Levels.ToList(),
        DiceRolls = _diceRolls.ToList(),
        PositionPattern = ParsePositionPattern(_positionPatternText),
    };

    // Inverse of BuildConfig: project a config onto the buffers / enum state.
    private void HydrateFrom(FilterConfig cfg)
    {
        _playerText = string.Join(", ", cfg.Players);
        _decisionType = cfg.DecisionType;
        _matchScoreText = string.Join(", ", cfg.MatchScores);
        _errorMinText = FormatNumber(cfg.ErrorMin);
        _errorMaxText = FormatNumber(cfg.ErrorMax);
        _moveNumberMinText = FormatNumber(cfg.MoveNumberMin);
        _moveNumberMaxText = FormatNumber(cfg.MoveNumberMax);
        _contactTypes = new HashSet<ContactType>(cfg.ContactTypes);
        _evaluations.Include = cfg.IncludeEvaluations;
        _evaluations.Levels = new HashSet<AnalysisLevel>(cfg.EvaluationLevels);
        _rollouts.Include = cfg.IncludeRollouts;
        _rollouts.Levels = new HashSet<AnalysisLevel>(cfg.RolloutLevels);
        _bookRollouts.Include = cfg.IncludeBookRollouts;
        _bookRollouts.Levels = new HashSet<AnalysisLevel>(cfg.BookRolloutLevels);
        _diceRolls = new HashSet<DiceRoll>(cfg.DiceRolls);
        _positionPatternText = cfg.PositionPattern?.ToBracketList() ?? string.Empty;
    }

    // True when the position-pattern buffer is committable: a blank buffer is
    // "no pattern filter," and any non-blank buffer must parse as a bracket
    // list. Drives both the field's is-invalid styling and the Apply gate, so
    // half-typed input is flagged rather than silently dropped at Apply.
    private bool IsPositionPatternValid =>
        string.IsNullOrWhiteSpace(_positionPatternText)
        || BoardPattern.TryParse(_positionPatternText, out _);

    // Buffer → PositionPattern. A blank buffer is no filter (null); otherwise
    // the parsed pattern. TryParse can only fail here for invalid text, which
    // the Apply gate (IsPositionPatternValid) already prevents from reaching
    // BuildConfig — the null fallback is a defensive belt, not a silent drop.
    // (For the hidden-active signal's BuildConfig call the gate does not
    // apply, so mid-edit unparseable text lands here as null — an inactive
    // facet, which is the honest verdict for text Apply would refuse.)
    private static BoardPattern? ParsePositionPattern(string raw) =>
        string.IsNullOrWhiteSpace(raw)
            ? null
            : BoardPattern.TryParse(raw, out var pattern) ? pattern : null;

    private static List<string> SplitTokens(string raw) =>
        raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
           .Where(s => s.Length > 0).ToList();

    private static double? ParseDouble(string raw) =>
        double.TryParse(raw, System.Globalization.NumberStyles.Any,
                        System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;

    private static int? ParseInt(string raw) =>
        int.TryParse(raw, System.Globalization.NumberStyles.Integer,
                     System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;

    private static string FormatNumber<T>(T? value) where T : struct, IFormattable =>
        value?.ToString(null, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
}
